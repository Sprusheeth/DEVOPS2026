<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Booking System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0f172a;
            --surface: #1e293b;
            --surface-hover: #334155;
            --border: #334155;
            --text: #f1f5f9;
            --text-muted: #94a3b8;
            --accent: #6366f1;
            --accent-hover: #818cf8;
            --success: #22c55e;
            --success-hover: #16a34a;
            --danger: #ef4444;
            --gradient: linear-gradient(135deg, #6366f1, #8b5cf6, #a855f7);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        /* Header */
        .header {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 20px 0;
            position: sticky;
            top: 0;
            z-index: 10;
            backdrop-filter: blur(12px);
        }

        .header-inner {
            max-width: 960px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 22px;
            font-weight: 700;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: var(--gradient);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .badge {
            background: var(--accent);
            color: #fff;
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 20px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* Container */
        .container {
            max-width: 960px;
            margin: 0 auto;
            padding: 32px 24px 60px;
        }

        /* Section Titles */
        .section-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text);
        }

        .section-title .icon {
            font-size: 20px;
        }

        /* Card */
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 28px;
            margin-bottom: 32px;
            transition: box-shadow 0.3s ease;
        }

        .card:hover {
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        /* Form */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .form-grid .full-width {
            grid-column: 1 / -1;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-group input {
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 14px;
            font-family: inherit;
            color: var(--text);
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
        }

        .form-group input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }

        .form-group input::placeholder {
            color: #475569;
        }

        .btn-submit {
            background: var(--gradient);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 13px 28px;
            font-size: 15px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.2s;
            margin-top: 4px;
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        /* Events Grid */
        .events-grid {
            display: grid;
            gap: 16px;
        }

        .event-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 22px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
        }

        .event-card:hover {
            border-color: var(--accent);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        }

        .event-details h3 {
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .event-meta {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: var(--text-muted);
        }

        .meta-item .emoji {
            font-size: 15px;
        }

        /* Slots indicator */
        .slots-section {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
            min-width: 140px;
        }

        .slots-bar-container {
            width: 120px;
            height: 6px;
            background: var(--bg);
            border-radius: 3px;
            overflow: hidden;
        }

        .slots-bar {
            height: 100%;
            border-radius: 3px;
            background: var(--success);
            transition: width 0.4s ease;
        }

        .slots-bar.warning {
            background: #f59e0b;
        }

        .slots-bar.full {
            background: var(--danger);
        }

        .slots-text {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-muted);
        }

        .slots-text strong {
            color: var(--text);
        }

        .slots-text.full-text {
            color: var(--danger);
            font-weight: 600;
        }

        .btn-book {
            background: var(--success);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 9px 20px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s;
        }

        .btn-book:hover {
            background: var(--success-hover);
            transform: translateY(-1px);
        }

        .btn-book:disabled {
            background: #374151;
            color: #6b7280;
            cursor: not-allowed;
            transform: none;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 48px 20px;
            color: var(--text-muted);
        }

        .empty-state .emoji {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .empty-state p {
            font-size: 15px;
        }

        /* Stats Bar */
        .stats-bar {
            display: flex;
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-chip {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 20px;
            font-size: 13px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .stat-chip strong {
            color: var(--text);
            font-size: 18px;
        }

        /* Responsive */
        @media (max-width: 640px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .event-card {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }

            .slots-section {
                align-items: flex-start;
                width: 100%;
            }

            .stats-bar {
                flex-direction: column;
            }

            .header-inner {
                flex-direction: column;
                gap: 8px;
            }
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header class="header">
        <div class="header-inner">
            <div class="logo">
                <div class="logo-icon">📅</div>
                EventHub
            </div>
            <span class="badge">MongoDB + Node.js</span>
        </div>
    </header>

    <div class="container">

        <!-- Stats -->
        <div class="stats-bar">
            <div class="stat-chip">
                <span>Total Events</span>
                <strong>
                    <%= events.length %>
                </strong>
            </div>
            <div class="stat-chip">
                <span>Total Bookings</span>
                <strong>
                    <%= events.reduce((sum, e)=> sum + e.bookedSlots, 0) %>
                </strong>
            </div>
            <div class="stat-chip">
                <span>Available Slots</span>
                <strong>
                    <%= events.reduce((sum, e)=> sum + (e.totalSlots - e.bookedSlots), 0) %>
                </strong>
            </div>
        </div>

        <!-- Create Event Form -->
        <div class="section-title"><span class="icon">✨</span> Create New Event</div>
        <div class="card">
            <form action="/events" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Event Name</label>
                        <input type="text" name="name" placeholder="e.g. Tech Conference 2026" required>
                    </div>
                    <div class="form-group">
                        <label>Date</label>
                        <input type="date" name="date" required>
                    </div>
                    <div class="form-group">
                        <label>Location</label>
                        <input type="text" name="location" placeholder="e.g. Mumbai, India" required>
                    </div>
                    <div class="form-group">
                        <label>Total Slots</label>
                        <input type="number" name="totalSlots" placeholder="e.g. 100" min="1" required>
                    </div>
                    <div class="full-width">
                        <button type="submit" class="btn-submit">🚀 Create Event</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Events List -->
        <div class="section-title"><span class="icon">📋</span> All Events</div>

        <% if (events.length===0) { %>
            <div class="card">
                <div class="empty-state">
                    <div class="emoji">🎭</div>
                    <p>No events yet — create your first event above!</p>
                </div>
            </div>
            <% } else { %>
                <div class="events-grid">
                    <% events.forEach(event=> {
                        const pct = Math.round((event.bookedSlots / event.totalSlots) * 100);
                        const barClass = pct >= 100 ? 'full' : pct >= 70 ? 'warning' : '';
                        %>
                        <div class="event-card">
                            <div class="event-details">
                                <h3>
                                    <%= event.name %>
                                </h3>
                                <div class="event-meta">
                                    <span class="meta-item"><span class="emoji">📍</span>
                                        <%= event.location %>
                                    </span>
                                    <span class="meta-item"><span class="emoji">🗓️</span>
                                        <%= event.date %>
                                    </span>
                                </div>
                            </div>
                            <div class="slots-section">
                                <div class="slots-bar-container">
                                    <div class="slots-bar <%= barClass %>" style="width: <%= pct %>%"></div>
                                </div>
                                <span class="slots-text <%= pct >= 100 ? 'full-text' : '' %>">
                                    <strong>
                                        <%= event.bookedSlots %>
                                    </strong> / <%= event.totalSlots %> booked
                                        <% if (pct>= 100) { %> — FULL <% } %>
                                </span>
                                <form action="/events/<%= event._id %>/book" method="POST" style="margin:0;">
                                    <button type="submit" class="btn-book" <% if (event.bookedSlots>= event.totalSlots)
                                        { %> disabled <% } %>>
                                            <% if (event.bookedSlots>= event.totalSlots) { %>
                                                Sold Out
                                                <% } else { %>
                                                    Book Now
                                                    <% } %>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>

    </div>

</body>

</html>